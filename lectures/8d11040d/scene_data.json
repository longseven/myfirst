  "detail_rules": [
    {
      "condition": {
        "all": [
          "ln_PA",
          "ln_AB",
          "ln_BC"
        ]
      },
      "content": [
        {
          "type": "desc",
          "v": "由勾股定理逆定理："
        },
        {
          "type": "tex",
          "v": "AB^2+BC^2=3+1=4=AC^2 \\Rightarrow AB \\perp BC"
        }
      ]
    },
    {
      "condition": {
        "all": [
          "ln_AD",
          "ln_BC"
        ]
      },
      "content": [
        {
          "type": "desc",
          "v": "证明平行："
        },
        {
          "type": "tex",
          "v": "\\vec{AD}=(0,1,0), \\vec{BC}=(0,1,0) \\Rightarrow AD \\parallel BC"
        }
      ]
    },
    {
      "condition": {
        "all": [
          "pl_ACP",
          "pl_DCP"
        ]
      },
      "content": [
        {
          "type": "desc",
          "v": "二面角法向量夹角："
        },
        {
          "type": "tex",
          "v": "|\\cos\\theta| = \\frac{|\\vec{n_1}\\cdot\\vec{n_2}|}{|\\vec{n_1}||\\vec{n_2}|}"
        }
      ]
    }
  ],

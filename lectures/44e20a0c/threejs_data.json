  "solution_script": [
    {
      "phase": "审题",
      "speech": "已知 PA 垂直于平面 ABC，这是解题的关键信息，说明 PA 是四面体的高。",
      "els": [
        "ln_PA",
        "pl_ABC"
      ],
      "cam": {
        "position": [
          6,
          5,
          7
        ]
      }
    },
    {
      "phase": "建立坐标系",
      "speech": "以 A 为原点建立坐标系，令平面 ABC 为 xy 平面，则 P 在 z 轴上。",
      "els": [
        "coord_axes"
      ],
      "cam": {
        "position": [
          8,
          3,
          4
        ]
      }
    },
    {
      "phase": "标记关键量",
      "speech": "设底面三角形 ABC 的面积为 S，PA 的长度为 h，这些都是已知量或待求量。",
      "els": [
        "vec_PA",
        "pl_ABC"
      ],
      "cam": {
        "position": [
          5,
          4,
          6
        ]
      }
    },
    {
      "phase": "分析几何关系",
      "speech": "因为 PA 垂直于平面 ABC，所以 PA 垂直于底面内任意直线，包括 AB 和 AC。",
      "els": [
        "vec_PA",
        "vec_AB",
        "vec_AC"
      ],
      "cam": {
        "position": [
          6,
          5,
          7
        ]
      }
    },
    {
      "phase": "展示垂直关系",
      "speech": "从动画中可以看到 PA 与底面内的任意方向都保持垂直，这是由给定条件保证的。",
      "els": [
        "right_angles"
      ],
      "cam": {
        "position": [
          7,
          4,
          5
        ]
      }
    },
    {
      "phase": "确定体积公式",
      "speech": "四面体体积公式是 V = 一半的底面积乘以高，即底面 ABC 面积乘以 PA 长度再除以三。",
      "els": [
        "pl_ABC",
        "ln_PA"
      ],
      "cam": {
        "position": [
          6,
          5,
          7
        ]
      }
    },
    {
      "phase": "代入具体数值",
      "speech": "以 AB=3, AC=4 为例，底面直角三角形面积为 6，PA=5。",
      "els": [
        "vec_AB",
        "vec_AC",
        "ln_PA"
      ],
      "cam": {
        "position": [
          5,
          4,
          6
        ]
      }
    },
    {
      "phase": "计算具体结果",
      "speech": "体积 V = 三分之一乘以 6 乘以 5 = 10，这就是该四面体的体积。",
      "els": [
        "ln_PA",
        "pl_ABC"
      ],
      "cam": {
        "position": [
          6,
          5,
          7
        ]
      }
    },
    {
      "phase": "从另一视角观察",
      "speech": "换一个角度看，四面体的四个面都清晰可见，结构非常规整。",
      "els": [
        "all_planes"
      ],
      "cam": {
        "position": [
          4,
          6,
          8
        ]
      }
    },
    {
      "phase": "演示体积构成",
      "speech": "想象以底面 ABC 为基准，PA 作为高度，四面体的体积就是这个直三棱锥的体积。",
      "els": [
        "pl_ABC",
        "ln_PA"
      ],
      "cam": {
        "position": [
          7,
          5,
          6
        ]
      }
    },
    {
      "phase": "总结方法",
      "speech": "本题的核心是利用 PA 垂直于底面这一条件，将 PA 作为四面体的高来计算体积。",
      "els": [
        "vec_PA",
        "pl_ABC"
      ],
      "cam": {
        "position": [
          6,
          5,
          7
        ]
      }
    }
  ]

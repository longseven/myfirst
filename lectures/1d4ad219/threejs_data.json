  "solution_script": [
    {
      "phase": "审题",
      "speech": "圆台下底半径√2，内接正方形ABCD，上底有E、M。已知面ABE⊥面ABCD，AF⊥DE。目标是证明EA=EB，并求ME长度。",
      "els": [
        "frustum_main",
        "pl_ABE",
        "pl_ABCD",
        "ln_AF",
        "ln_DE"
      ],
      "cam": []
    },
    {
      "phase": "建系",
      "speech": "以D为原点，DA为x轴，DC为y轴，z轴向上建立坐标系。由正方形性质，D(0,0,0)，A(√2,0,0)，B(√2,√2,0)，C(0,√2,0)。",
      "els": [
        "coord_axes",
        "D",
        "A",
        "B",
        "C"
      ],
      "cam": []
    },
    {
      "phase": "确定上底",
      "speech": "圆台是直圆台，所以上底圆心O₁在z轴上。OO₁=2，故O₁(0,0,2)。",
      "els": [
        "O",
        "O1",
        "ln_OO1"
      ],
      "cam": []
    },
    {
      "phase": "设参E点",
      "speech": "设E在圆O₁上，半径设为r，则E(x_E,y_E,2)，满足x_E²+y_E²=r²。",
      "els": [
        "E",
        "O1",
        "ln_O1E"
      ],
      "cam": []
    },
    {
      "phase": "利用面面垂直条件①",
      "speech": "由面ABE⊥面ABCD，AB=(0,√2,0)，AE=(x_E-√2,y_E,2)。面ABE的法向量n_ABE=AB×AE，其z分量为-(√2·x_E+√2·y_E)。",
      "els": [
        "pl_ABE",
        "vec_AB",
        "vec_AE",
        "nrm_ABE"
      ],
      "cam": []
    },
    {
      "phase": "利用面面垂直条件②",
      "speech": "由于面ABE⊥面ABCD，法向量n_ABE应平行于xy平面，即z分量为0。所以√2·x_E+√2·y_E=0，即y_E=-x_E。E的投影在直线y=-x上。",
      "els": [
        "pl_ABE",
        "pl_ABCD"
      ],
      "cam": []
    },
    {
      "phase": "利用AF⊥DE",
      "speech": "F是BC中点，故F(0,√2,0)。AF=(-√2,√2,0)，DE=(x_E,y_E,2)。由AF⊥DE，两向量点乘为零：-√2·x_E+√2·y_E=0。",
      "els": [
        "F",
        "ln_AF",
        "ln_DE",
        "vec_AF",
        "vec_DE"
      ],
      "cam": []
    },
    {
      "phase": "确定E的坐标",
      "speech": "联立y_E=-x_E和-x_E+y_E=0得y_E=-x_E，且x_E²+y_E²=r²。由第一问EA=EB的要求（即E到A和B距离相等），解得x_E=-1,y_E=1,r²=2。",
      "els": [
        "E",
        "ln_AE",
        "ln_BE",
        "vec_AE",
        "vec_BE"
      ],
      "cam": []
    },
    {
      "phase": "证明EA=EB",
      "speech": "E(-1,1,2)，A(√2,0,0)，B(√2,√2,0)。|EA|²=(-1-√2)²+1²+4=6，|EB|²=(-1-√2)²+(1-√2)²+4=6，故EA=EB=√6。",
      "els": [
        "ln_AE",
        "ln_BE",
        "E",
        "A",
        "B"
      ],
      "cam": []
    },
    {
      "phase": "分析第二问",
      "speech": "第二问：OO₁=2已满足。设M在圆O₁上，M(x_M,y_M,2)，x_M²+y_M²=2。需用线面角条件求ME。",
      "els": [
        "M",
        "O1",
        "ln_O1M"
      ],
      "cam": []
    },
    {
      "phase": "计算F到面ADE的距离①",
      "speech": "先求面ADE的法向量。AD=(-√2,0,0)，AE=(-1-√2,1,2)。用叉积算n=(AD×AE)。",
      "els": [
        "pl_ADE",
        "vec_AD",
        "vec_AE",
        "nrm_ADE"
      ],
      "cam": []
    },
    {
      "phase": "计算F到面ADE的距离②",
      "speech": "计算标量三重积(AF,AD,AE)=4√2，面ADE面积|AD×AE|=2√2，故d(F,面ADE)=|4√2|÷2√2=2。",
      "els": [
        "ln_AF",
        "nrm_ADE"
      ],
      "cam": []
    },
    {
      "phase": "建立线面角方程",
      "speech": "设α为FM与面ADE所成角，sinα=d(F,面ADE)÷|FM|=2÷|FM|=3√10/10，故|FM|²=40/9≈4.444。",
      "els": [
        "ln_FM"
      ],
      "cam": []
    },
    {
      "phase": "计算|FM|²",
      "speech": "F(0,√2,0)，M(x_M,y_M,2)，|FM|²=x_M²+(y_M-√2)²+4=8-2√2·y_M=40/9，解得y_M=-1。",
      "els": [
        "F",
        "M",
        "ln_FM"
      ],
      "cam": []
    },
    {
      "phase": "确定M的坐标",
      "speech": "由x_M²+y_M²=2且y_M=-1，得x_M=0或x_M=0。故M(0,-1,2)。",
      "els": [
        "M",
        "O1"
      ],
      "cam": []
    },
    {
      "phase": "验证线面角",
      "speech": "验证：|FM|²=2+(√2+1)²+4=5，故|FM|=√5，sinα=2÷√5=3√10/10。条件满足！",
      "els": [
        "ln_FM",
        "F",
        "M"
      ],
      "cam": []
    },
    {
      "phase": "计算ME长度",
      "speech": "最后求ME：E(-1,1,2)，M(0,-1,2)，|EM|²=1+4+0=5，故ME=√5。",
      "els": [
        "ln_EM",
        "E",
        "M"
      ],
      "cam": []
    },
    {
      "phase": "总结",
      "speech": "回顾全程：建系利用面ABE⊥ABCD得E投影在y=-x上，再用AF⊥DE锁定E的具体位置。由线面角正弦值反推出M的坐标，最终求得ME=√5。",
      "els": [
        "frustum_main",
        "ln_EM",
        "ln_AE",
        "ln_BE"
      ],
      "cam": []
    }
  ]
}